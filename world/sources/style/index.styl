.classic-links
    position fixed
    left 12px
    bottom 12px
    z-index 8
    display flex
    flex-wrap wrap
    gap 6px
    max-width calc(100vw - 24px)
    font-family 'Nunito', sans-serif
    font-size 13px
    font-weight 700

    a
    button
        padding 6px 11px
        border-radius 999px
        color #f3ece6
        text-decoration none
        background rgba(21, 17, 15, 0.76)
        border 1px solid rgba(243, 236, 230, 0.22)
        backdrop-filter blur(8px)
        transition background 0.2s, border-color 0.2s, color 0.2s

        &:hover
        &:focus-visible
            background #ef7a3c
            border-color #ef7a3c
            color #15110f
            outline 2px solid #fff
            outline-offset 2px

.modals
    &.is-displayed
        background rgba(12, 9, 8, 0.62)
        backdrop-filter blur(6px)

.modal.page-viewer
    width min(1140px, 94vw)
    height min(86vh, 880px)

    @media only screen and (max-width 640px)
        width 96vw
        height 90vh

    .page-viewer-shell
        display flex
        flex-direction column
        width 100%
        height 100%
        border-radius 18px
        overflow hidden
        background #15110f
        border 1px solid rgba(243, 236, 230, 0.18)
        box-shadow 0 24px 80px rgba(0, 0, 0, 0.72)

    .page-viewer-bar
        display flex
        align-items center
        justify-content space-between
        gap 12px
        padding 12px 18px
        background #211a17
        border-bottom 1px solid rgba(243, 236, 230, 0.14)
        flex-shrink 0

    .page-viewer-title
        font-family 'Amatic SC', sans-serif
        font-size 1.7rem
        font-weight 700
        letter-spacing 0.03em
        color #f3ece6
        line-height 1

    .page-viewer-actions
        display flex
        align-items center
        gap 10px

    .page-viewer-theme
        display inline-flex
        align-items center
        justify-content center
        width 36px
        height 36px
        border-radius 999px
        border 1px solid rgba(243, 236, 230, 0.24)
        color #f3ece6
        font-size 1rem
        line-height 1
        cursor pointer
        transition border-color 0.2s, color 0.2s, background 0.2s

        &:hover
            border-color #f2877d
            color #ef7a3c

    .page-viewer-ext
        font-family 'Nunito', sans-serif
        font-size 0.75rem
        font-weight 700
        color #ffc65c
        text-decoration none
        padding 6px 12px
        border-radius 999px
        border 1px solid rgba(255, 198, 92, 0.4)
        transition background 0.2s, color 0.2s

        &:hover
            background #ffc65c
            color #15110f

    .page-viewer-close
        display flex
        align-items center
        justify-content center
        width 36px
        height 36px
        opacity 0.75
        cursor pointer

        &:hover
            opacity 1

        .icon.is-xbox
            display none

    .page-viewer-frame
        flex 1
        width 100%
        height 100%
        border 0
        background #15110f

    &.is-light
        .page-viewer-shell
            background #f6f6f4
            border-color rgba(29, 24, 21, 0.16)

        .page-viewer-bar
            background #ffffff
            border-bottom-color rgba(29, 24, 21, 0.14)

        .page-viewer-title
            color #1d1815

        .page-viewer-theme
            border-color rgba(29, 24, 21, 0.2)
            color #1d1815

            &:hover
                border-color #c25a1f
                color #c25a1f

        .page-viewer-ext
            color #8a5a00
            border-color rgba(138, 90, 0, 0.4)

            &:hover
                background #8a5a00
                color #ffffff

        .page-viewer-close .icon.is-default
            filter invert(1)

        .page-viewer-frame
            background #f6f6f4

.map-teleport-hint
    position absolute
    top 14px
    left 50%
    transform translateX(-50%)
    z-index 2000
    padding 6px 14px
    border-radius 999px
    background rgba(21, 17, 15, 0.82)
    border 1px solid rgba(255, 198, 92, 0.45)
    color #ffc65c
    font-family 'Nunito', sans-serif
    font-size 0.75rem
    font-weight 700
    white-space nowrap
    pointer-events none

.load-error
    position fixed
    top 0
    left 0
    right 0
    bottom 0
    z-index 100
    display flex
    align-items center
    justify-content center
    background rgba(20, 8, 24, 0.92)
    color #fff
    font-family 'Nunito', sans-serif
    text-align center

    &[hidden]
        display none

    .box
        max-width 420px
        padding 24px

    .title
        font-size 28px
        font-weight 900
        margin 0 0 12px

    .text
        margin 0 0 8px

    .sub
        opacity 0.7
        font-size 14px

    .actions
        display flex
        flex-wrap wrap
        gap 10px
        justify-content center
        margin-top 16px

        button
        a
            padding 10px 16px
            border-radius 6px
            border 0
            background #C21515
            color #fff
            font inherit
            font-weight 700
            text-decoration none
            cursor pointer

.noscript-box
    position fixed
    top 0
    left 0
    right 0
    bottom 0
    z-index 200
    display flex
    align-items center
    justify-content center
    padding 24px
    background #1a0a1c
    color #fff
    font-family sans-serif
    text-align center

    a
        color #ffb3b3
